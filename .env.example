# Copy to .env and adjust:  cp .env.example .env
# These settings configure the container; they are NOT passed to the agent.
# Don't put secrets here.

# Host ports (on 127.0.0.1). Change them if you run several sandboxes at once.
FRONTEND_PORT=3000
CHAIN_PORT=8545

# Memory cap for the sandbox (also limited by memory= in your .wslconfig)
MEM_LIMIT=6g

# Tools to install at build time (true/false)
INSTALL_FOUNDRY=true
INSTALL_CLAUDE_CODE=true

# Troubleshooting only:
# IPTABLES=iptables-legacy   # if the firewall fails with "iptables-restore failed"
# DNS_ALLOW_ANY=true         # if DNS stops working after the firewall is applied
