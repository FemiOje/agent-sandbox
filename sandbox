#!/usr/bin/env bash
#
# Helper for the agent sandbox. Run from WSL: ./sandbox <command>
#
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")"

SERVICE=sandbox
dc() { docker compose "$@"; }

usage() {
  cat <<'EOF'
Usage: ./sandbox <command>

  up                Build (if needed) and start; waits until the firewall is ready
  shell             Open a shell as the agent user (no root, no capabilities)
  claude [args]     Run Claude Code as the agent user
  run <cmd...>      Run any command as the agent user
  admin             Open a ROOT shell (for you only; can change the firewall)
  approve [--once]  Answer the agent's requests for sites not in allowed-domains.txt
                    (keeps watching until Ctrl+C; --once answers what's waiting now)
  netlog [N]        Show the last N proxy log lines: allowed, asked, denied (default 50)
  firewall          Re-apply the firewall rules
  test              Run the security tests against the running sandbox
  status            Show container status
  logs              Follow container logs
  cp-out <path> [dest]  Copy work/<path> out of the sandbox (default: ./exports/)
  cp-in <src> [path]    Copy a file or folder into work/[path]
  stop              Stop the container (keeps your code)
  down              Remove the container (keeps your code in the volume)
  destroy           Remove the container AND the volumes (deletes your code)
EOF
}

# Talk to the approval proxy (runs as root, then as the proxy user; see
# container/proxy-ctl). stdin is closed so it can't eat a caller's input.
proxy_ctl() { dc exec -T "$SERVICE" proxy-ctl "$@" </dev/null | tr -d '\r'; }

add_allowed() {
  local f=allowed-domains.txt
  grep -qE "^[[:space:]]*$(printf '%s' "$1" | sed 's/[.]/\\./g')([[:space:]#]|$)" "$f" && return 0
  [ -z "$(tail -c1 "$f")" ] || echo >> "$f"
  # Append, don't rewrite: the container sees the file through a bind mount
  # of this exact inode.
  printf '%s   # approved %s\n' "$1" "$(date +%F)" >> "$f"
}

approve() {
  local watch=true skipped=" " shown list host since port count ans
  [ "${1:-}" = "--once" ] && watch=false
  $watch && echo "Waiting for the agent to ask for new sites (Ctrl+C to stop)..."
  while :; do
    list="$(proxy_ctl list)" || return 1
    shown=false
    while IFS=$'\t' read -r host since port count; do
      [ -n "$host" ] || continue
      case "$skipped" in *" $host "*) continue ;; esac
      shown=true
      printf '\a\n  %s   (port %s, %s request(s), waiting %ss)\n' \
        "$host" "$port" "$count" "$(( $(date +%s) - since ))"
      read -r -p "  [a]llow this session, [A]lways (add to allowed-domains.txt), [d]eny, [s]kip? " ans </dev/tty
      case "$ans" in
        a) proxy_ctl allow "$host" && echo "  allowed until the sandbox restarts" ;;
        A) add_allowed "$host" && proxy_ctl allow "$host" && echo "  added to allowed-domains.txt" ;;
        d) proxy_ctl deny "$host" && echo "  denied until the sandbox restarts" ;;
        *) skipped="$skipped$host "; echo "  skipped (still waiting)" ;;
      esac
    done <<< "$list"
    if ! $watch; then
      $shown || echo "No sites are waiting for an answer."
      return 0
    fi
    sleep 1
  done
}

cmd="${1:-help}"
[ "$#" -gt 0 ] && shift

case "$cmd" in
  up)       dc up -d --build --wait "$@" && echo "Sandbox ready. Try: ./sandbox shell" ;;
  shell)    dc exec "$SERVICE" agent-exec bash -l ;;
  claude)   dc exec "$SERVICE" agent-exec claude "$@" ;;
  run)      [ "$#" -gt 0 ] || { echo "usage: ./sandbox run <command...>"; exit 1; }
            dc exec "$SERVICE" agent-exec "$@" ;;
  admin)    dc exec "$SERVICE" bash ;;
  approve)  approve "$@" ;;
  netlog)   proxy_ctl log "${1:-50}" ;;
  firewall) dc exec "$SERVICE" init-firewall.sh ;;
  test)     ./tests/run-tests.sh "$@" ;;
  status)   dc ps ;;
  logs)     dc logs -f "$SERVICE" ;;
  cp-out)   [ "$#" -ge 1 ] || { echo "usage: ./sandbox cp-out <path> [dest]"; exit 1; }
            dest="${2:-./exports/}"; mkdir -p "$(dirname "$dest")" ./exports
            dc cp "$SERVICE:/home/node/work/$1" "$dest" ;;
  cp-in)    [ "$#" -ge 1 ] || { echo "usage: ./sandbox cp-in <src> [path]"; exit 1; }
            dc cp -a "$1" "$SERVICE:/home/node/work/${2:-}" ;;
  stop)     dc stop ;;
  down)     dc down ;;
  destroy)  read -r -p "Delete the sandbox AND all code in its volumes? [y/N] " ans
            [ "$ans" = "y" ] || [ "$ans" = "Y" ] || { echo "Cancelled."; exit 0; }
            dc down -v ;;
  help|-h|--help) usage ;;
  *) echo "Unknown command: $cmd"; echo; usage; exit 1 ;;
esac
